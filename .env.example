# Demo mode requires no Supabase project and is safe for local UI exploration.
VITE_DEMO_MODE=true

# When demo mode is false, both browser-safe Supabase values are required.
# Never place a service-role key, secret key, database password, or server token here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
